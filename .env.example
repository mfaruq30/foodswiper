# Munch — required environment variables, documented per spec §10.8.
# Copy to .env and fill in. Real values live in environment / secret managers,
# never in the repo.
#
# DEGRADED-MODE GUARANTEE: the app must run with ZERO secrets configured.
# Without ANTHROPIC_API_KEY, card reasons fall back to deterministic templates;
# the free demo runs end-to-end on the in-memory backend (MUNCH_BACKEND=memory,
# MUNCH_AUTH=dev) with no Firebase, no Apple, and no Anthropic key at all.

# --- Supabase (Phase 1+) -----------------------------------------------------
# Project URL and anon (publishable) key — safe to embed in the iOS client;
# everything they can reach is gated by Row Level Security.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — SERVER SIDE ONLY (seed pipeline, re-sync cron, admin edge
# functions). Bypasses RLS; treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for the seed/re-sync pipeline (GitHub
# Actions cron), e.g. postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# --- Recommendation service (Phase 3+) ---------------------------------------
# Public base URL of the FastAPI service (Cloud Run). The iOS app calls this
# over HTTPS with the user's Firebase ID token in the Authorization header.
RECO_SERVICE_URL=

# --- Recommendation service runtime (Firebase, D-019) ------------------------
# Backend + auth selection. Production = firestore/firebase; the $0 demo = the
# in-memory adapters with dev auth (no secrets required).
#   MUNCH_BACKEND : firestore (default) | memory
#   MUNCH_AUTH    : firebase  (default) | dev   (dev = trust a header uid; NEVER
#                   enable outside a demo build)
#   FIREBASE_PROJECT_ID : Firestore + Firebase Auth project (default food-5eb2a)
#   VENUES_NDJSON : seed file the memory backend loads (demo only)
MUNCH_BACKEND=firestore
MUNCH_AUTH=firebase
FIREBASE_PROJECT_ID=food-5eb2a
VENUES_NDJSON=venues.ndjson

# --- Anthropic (Phase 5, OPTIONAL) --------------------------------------------
# Server-side only. Absence is a supported configuration: reasons use the
# templated fallback. Set a monthly spend cap in the Anthropic Console BEFORE
# creating this key (see docs/RUNBOOK.md).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Apple Sign-in (Phase 6, OPTIONAL) ---------------------------------------
# Sign in with Apple credentials, read by the reco service's apple_auth.py to
# mint the ES256 client_secret and revoke the user's refresh token on account
# deletion (Apple TN3194, D-013). ALL FOUR must be set for the revoke path to
# activate; with any missing, build_from_env() returns None and deletion still
# purges data, just without the live /auth/revoke call (the supported demo/dev
# configuration).
#
# Provide the .p8 private key by ONE of: APPLE_PRIVATE_KEY (the PEM contents
# inline, e.g. a Cloud Run secret) OR APPLE_PRIVATE_KEY_PATH (a file path). The
# .p8 is a FILE SECRET — never commit it and never paste its contents here.
APPLE_TEAM_ID=
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
