{
  // Deno configuration for all Munch edge functions (Phase 3 adds the
  // functions themselves; Phase 0 wires lint/fmt/test so the toolchain is
  // enforced from the first commit).
  "lint": {
    "rules": {
      "tags": ["recommended"],
      // no-explicit-any is already in "recommended"; it is pinned explicitly so
      // an upstream change to that tag set can never silently relax the spec's
      // outright ban on `any` (§6.2).
      "include": ["no-explicit-any"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.6"
  }
}
