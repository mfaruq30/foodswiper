# Secrets never enter the repo (spec §10.8) — .env.example documents required vars.
.env
.env.*
!.env.example
# Apple Sign-in private key. APPLE_PRIVATE_KEY_PATH can point the .p8 at a local
# file; this belt-and-suspenders glob stops it ever being committed. Production
# loads it from Secret Manager, never the repo (docs/RELEASE.md §4).
*.p8

# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
dist/

# Swift / Xcode
# .xcodeproj is GENERATED by XcodeGen in CI from ios/Munch/project.yml —
# the repo is authored on Windows where Xcode cannot run, so the generated
# project is never committed (it would instantly drift from project.yml).
*.xcodeproj/
.build/
.swiftpm/
DerivedData/
xcuserdata/

# Firebase client config. Not a hard secret (it's protected by Security Rules),
# but kept out of the repo so the DEFAULT build stays Firebase-free — the demo
# / CI run on DemoAuthProvider, and only a real release build (where the user
# drops this into Munch/Resources/) links FirebaseAuth. See docs/RELEASE.md.
GoogleService-Info.plist

# Supabase local stack
backend/supabase/.temp/
backend/supabase/.branches/

# Node (tooling only)
node_modules/

# OS noise
.DS_Store
Thumbs.db

# Seed pipeline artifacts (downloads + generated SQL)
backend/supabase/seed/.seed_cache/
backend/supabase/seed/seed_out/

# Trained learned-ranker artifact — regenerable via `learnedranker.train`
# (the ml-eval CI lane retrains + re-gates), so never committed.
backend/reco/models/
