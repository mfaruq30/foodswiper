# Secrets never enter the repo (spec §10.8) — .env.example documents required vars.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
dist/

# Swift / Xcode
# .xcodeproj is GENERATED by XcodeGen in CI from ios/Munch/project.yml —
# the repo is authored on Windows where Xcode cannot run, so the generated
# project is never committed (it would instantly drift from project.yml).
*.xcodeproj/
.build/
.swiftpm/
DerivedData/
xcuserdata/

# Supabase local stack
backend/supabase/.temp/
backend/supabase/.branches/

# Node (tooling only)
node_modules/

# OS noise
.DS_Store
Thumbs.db

# Seed pipeline artifacts (downloads + generated SQL)
backend/supabase/seed/.seed_cache/
backend/supabase/seed/seed_out/

# Trained learned-ranker artifact — regenerable via `learnedranker.train`
# (the ml-eval CI lane retrains + re-gates), so never committed.
backend/reco/models/
